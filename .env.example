APP_NAME="Audio Recording API"
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

STORAGE_PATH="uploads"
MAX_UPLOAD_SIZE_MB=50

GDRIVE_OAUTH_CLIENT_SECRET_FILE="client_secret.json"
GDRIVE_OAUTH_TOKEN_FILE="token.json"
GDRIVE_FOLDER_ID=""

NEONDB_CONNECTION_STRING="postgresql://app_user:change-me@localhost:5432/app_db"
POSTGRES_USER="app_user"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="app_db"

SECRET_KEY="replace-with-a-long-random-secret"

SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@example.com"
SMTP_TIMEOUT_SECONDS=15
FRONTEND_BASE_URL="http://localhost:3000"
PROJECT_NAME="Audio Recording API"

S3_BUCKET_NAME="replace-with-your-bucket"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="sa-east-1"
